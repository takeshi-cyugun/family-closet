# App Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3001

# Admin credentials — single-admin MVP (see CLAUDE.md "apps/admin" section for the security tradeoffs)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me
# openssl rand -hex 32 などで生成したランダムな文字列を設定する
ADMIN_SESSION_SECRET=change-me-to-a-long-random-string

# Supabase — Service Role Key を使うのはこの apps/admin だけに限定する
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Database Connection (for Drizzle)
DATABASE_URL=postgresql://postgres:password@db.your-supabase-project.supabase.co:5432/postgres
